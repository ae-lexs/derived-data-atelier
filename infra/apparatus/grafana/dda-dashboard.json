{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "OLTP latency p50 / p95 / p99 (ms)",
        "metrics": [
          ["DdaApi", "http_server_duration_milliseconds", { "stat": "p50", "label": "p50" }],
          ["DdaApi", "http_server_duration_milliseconds", { "stat": "p95", "label": "p95" }],
          ["DdaApi", "http_server_duration_milliseconds", { "stat": "p99", "label": "p99" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 60,
        "yAxis": { "left": { "min": 0, "label": "ms" } }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "OLTP throughput (req/s)",
        "metrics": [
          ["DdaApi", "http_server_request_count", { "stat": "Sum", "label": "req/s" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 60,
        "yAxis": { "left": { "min": 0, "label": "req/s" } }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Aurora ACU utilization",
        "metrics": [
          ["AWS/RDS", "ServerlessDatabaseCapacity", "DBClusterIdentifier", "dda-aurora", { "stat": "Average", "label": "ACUs" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 60,
        "yAxis": { "left": { "min": 0, "label": "ACUs" } }
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Aurora active connections",
        "metrics": [
          ["AWS/RDS", "DatabaseConnections", "DBClusterIdentifier", "dda-aurora", { "stat": "Average", "label": "connections" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 60,
        "yAxis": { "left": { "min": 0, "label": "count" } }
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Buffer-cache hit ratio (Performance Insights)",
