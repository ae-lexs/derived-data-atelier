        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 60,
        "yAxis": { "left": { "min": 0, "label": "s" } }
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 18,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "CDC end-to-end freshness lag (Module 05; from .cwli)",
        "metrics": [
          ["DdaApi", "cdc_freshness_lag_ms", { "stat": "Average", "label": "lag (ms)" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 60,
        "yAxis": { "left": { "min": 0, "label": "ms" } }
